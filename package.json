{
  "name": "@laddtnov/cyberpunk-ui",
  "version": "0.2.2",
  "description": "Zero-dependency cyberpunk neon CSS kit — design tokens, glow/glitch/scanline effects, form controls, and feedback components. WCAG-aware light theme, no build step.",
  "license": "MIT",
  "author": "Vladyslav Novytskyi <novytskiyvladislav@gmail.com> (https://laddtnov.xyz)",
  "homepage": "https://github.com/laddtnov/cyberpunk-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laddtnov/cyberpunk-ui.git"
  },
  "bugs": {
    "url": "https://github.com/laddtnov/cyberpunk-ui/issues"
  },
  "main": "cyberpunk-ui.css",
  "style": "cyberpunk-ui.css",
  "exports": {
    ".": "./cyberpunk-ui.css",
    "./tokens": "./tokens.css",
    "./effects": "./effects.css",
    "./components": "./components.css",
    "./forms": "./forms.css",
    "./feedback": "./feedback.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check:contrast": "node scripts/check-contrast.js"
  },
  "files": [
    "*.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "cyberpunk",
    "neon",
    "css",
    "ui",
    "ui-components",
    "css-framework",
    "design-tokens",
    "design-system",
    "forms",
    "accessibility",
    "wcag",
    "glitch",
    "scanlines",
    "glassmorphism",
    "vanilla-css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
